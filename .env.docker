# Points the app and scripts at the local Docker Postgres from
# docker-compose.yml. Committed on purpose: these are throwaway local creds.
# Loaded explicitly by the package.json scripts (`node --env-file` for the
# CLIs, sourced into the shell for `pnpm dev`); Next.js does not pick this
# file up on its own, so `pnpm dev:rds` is unaffected by it.
DATABASE_URL=postgres://camquest:camquest@localhost:5440/camquest

# Shared secret the ha-gateway service sends as `Authorization: Bearer …`
# to POST /api/ha-gateway/events. Local-only value; set a real one in
# Vercel (never NEXT_PUBLIC_, never in a URL).
HA_GATEWAY_WEBHOOK_SECRET=local-ha-gateway-secret

# Where Cam Quest calls ha-gateway's actions (POST /v1/actions/:name), e.g.
# the dev tools' phone notification. The API key is the gateway's
# CAM_QUEST_API_KEY; it's a real secret, so put both in .env.local (or
# Vercel), not here.
# HA_GATEWAY_URL=https://<your-gateway>.up.railway.app
# HA_GATEWAY_API_KEY=
