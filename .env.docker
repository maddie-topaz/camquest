# Points the app and scripts at the local Docker Postgres from
# docker-compose.yml. Committed on purpose: these are throwaway local creds.
# Loaded explicitly by the package.json scripts (`node --env-file` for the
# CLIs, sourced into the shell for `pnpm dev`); Next.js does not pick this
# file up on its own, so `pnpm dev:rds` is unaffected by it.
DATABASE_URL=postgres://camquest:camquest@localhost:5440/camquest
