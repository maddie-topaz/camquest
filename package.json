{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vercel env pull .env.local --yes && next dev",
    "dev:offline": "next dev",
    "dev:local": "pnpm db:up && pnpm db:migrate && set -a && . ./.env.docker && set +a && next dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:migrate",
    "db:migrate": "node --env-file=.env.docker scripts/migrate.mjs",
    "db:migrate:rds": "node --env-file=.env.local scripts/migrate.mjs",
    "db:psql": "docker compose exec db psql -U camquest camquest",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/rds-signer": "3.1123.0",
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/functions": "^3.9.5",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.18.3",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vercel": "^59.25.0",
    "vitest": "^4.1.11"
  }
}
